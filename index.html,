
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#101827">
<title>My Semental Advanced</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;padding:18px;background:#101827;
 color:#fff;font-family:Arial,sans-serif
}
header{text-align:center;padding:14px}
h1{color:#65e6a5;font-size:25px}
.panel{
 background:#1e293b;border-radius:15px;
 padding:16px;margin:15px 0
}
button{
 display:block;width:100%;padding:14px;
 margin-top:12px;border:0;border-radius:10px;
 background:#65e6a5;color:#102018;
 font-size:16px;font-weight:bold
}
input{max-width:100%;margin:12px 0}
#pantalla{
 background:#000;min-height:180px;
 border-radius:10px;display:flex;
 justify-content:center;align-items:center;
 text-align:center;padding:12px;color:#aab4c3
}
</style>
</head>
<body>
<header>
 <h1>🐎 My Semental Advanced</h1>
 <p>Tu consola portátil de Game Boy Advance</p>
</header>

<section class="panel">
 <h2>🎮 Biblioteca de juegos</h2>
 <p>Seleccioná una ROM de GBA.</p>
 <input id="rom" type="file" accept=".gba">
 <button id="iniciar">Iniciar juego</button>
 <p id="estado">Esperando un juego...</p>
</section>

<section class="panel">
 <h2>🕹️ Consola</h2>
 <div id="pantalla">
  Todavía no hay ningún juego ejecutándose.
 </div>
</section>

<section class="panel">
 <h2>⚙️ Mi emulador</h2>
 <p>Versión inicial de My Semental Advanced.</p>
 <p>Próximas funciones: guardados, trucos y controles táctiles.</p>
</section>

<script>
document.getElementById("iniciar").onclick=function(){
 const archivo=document.getElementById("rom").files[0];
 const estado=document.getElementById("estado");
 if(!archivo){
  estado.textContent="Primero seleccioná una ROM.";
  return;
 }
 estado.textContent="Archivo seleccionado: "+archivo.name+
 ". El motor GBA debe estar integrado para ejecutar el juego.";
};
</script>
</body>
</html>
